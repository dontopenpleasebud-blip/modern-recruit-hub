# Contact form email delivery (server-side only, never exposed to the browser)
#
# The site runs on an edge runtime, so raw SMTP (Gmail app passwords) is not
# supported. Use an HTTP email API instead — Resend is the simplest.
#
# 1) Create a free account at https://resend.com and generate an API key
# 2) Add these as project secrets (not committed to git)

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where contact-form messages get delivered
CONTACT_TO_EMAIL=katakambhargav073@gmail.com

# Verified sender on your Resend domain.
# Use onboarding@resend.dev while testing.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
